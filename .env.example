# On The Road — environment configuration (copy to .env; never commit .env)

# Bearer token for all API/WS access (>= 32 chars). Required in production.
ONTHEROAD_TOKEN=change-me-to-a-random-string-at-least-32-chars

# SQLite database file path (Docker uses /data/ontheroad.db).
ONTHEROAD_DB_PATH=./data/ontheroad.db

# Server port (fixed dev port 8100).
ONTHEROAD_PORT=8100

# Default workdir for new sessions (defaults to the server's cwd).
ONTHEROAD_DEFAULT_WORKDIR=

# Python interpreter of the installed hermes-agent venv (for the ACP adapter).
ONTHEROAD_HERMES_PYTHON=~/.hermes/hermes-agent/venv/bin/python

# Set to 1 to enable the opt-in live Hermes tests (burns real tokens).
ONTHEROAD_TEST_HERMES=0

# Seconds to wait for an interactive answer to an agent permission request
# before auto-approving the safest allow option (keeps the jam flowing).
ONTHEROAD_APPROVAL_TIMEOUT=120
